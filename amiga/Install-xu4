; $VER: Install-xu4 1.1svn-amigaos3-test1 (5.11.2026)
; The Amiga Installer script for xu4 (Ultima IV), an AmiCradle game port.
; Made by amicradle scripts/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the xu4 drawer where the archive was unpacked.

(set @app-name "xu4 (Ultima IV)")
(set #version "1.1svn-amigaos3-test1")
(set #drawer "xu4")
(set #program "xu4")
(set #space 11719)  ; KB

(onerror
    (message (cat "xu4 (Ultima IV) was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-xu4 again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "xu4 (Ultima IV) needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "xu4 (Ultima IV) needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "xu4 (Ultima IV) needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The xu4 drawer is not beside Install-xu4. Unpack the whole archive, then run Install-xu4 from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The xu4 drawer has no xu4 in it. Unpack the whole archive again."))

(welcome "This installs xu4 (Ultima IV) 1.1svn-amigaos3-test1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the xu4 drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called xu4 in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": xu4 (Ultima IV) needs 12 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "xu4 (Ultima IV) needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-xu4 again. Nothing has been installed."))
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copylib
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copylib-help)
        (source "LIBS:OpenGPU/SDL2.module")
        (dest "LIBS:GFOpenGPU")))
(complete 20)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "User") (noreq))
    (set #kept (if (= #kept "") "User" (cat #kept "|" "User"))))
(if (exists (tackon #dest "ultima4") (noreq))
    (set #kept (if (= #kept "") "ultima4" (cat #kept "|" "ultima4"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying xu4 (Ultima IV)")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating xu4 (Ultima IV). Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "xu4.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "xu4.info")))

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. xu4 (Ultima IV) would have gone in " #dest "."))
    (message (cat "xu4 (Ultima IV) 1.1svn-amigaos3-test1 is installed in " #dest "."
                  "\n\nTo start it, open the xu4 drawer and double-click the xu4 icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept ".")))))
(exit (quiet))
